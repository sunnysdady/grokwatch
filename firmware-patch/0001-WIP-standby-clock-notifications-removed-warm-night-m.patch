+// ---------------------------------------------------------------------------------------------
+// Standby clock (screen idle): pure black, HH:MM in one line, nothing else, no animation.
+// Inside the 200 px safe radius of the 466 round panel. Anti burn-in: the time steps along an
+// 8-point +-6 px orbit once per minute (one redraw per minute, no motion in between).
+static lv_obj_t *sb,*sb_t;
+static const signed char sb_orbit[8][2]={{0,0},{5,-3},{6,3},{2,6},{-3,5},{-6,1},{-5,-4},{-1,-6}};
+void gw_standby_create(lv_obj_t* parent){
+  sb=lv_obj_create(parent); lv_obj_remove_style_all(sb); lv_obj_set_size(sb,466,466); lv_obj_center(sb);
+  lv_obj_set_style_bg_color(sb,lv_color_black(),0); lv_obj_set_style_bg_opa(sb,LV_OPA_COVER,0);
+  lv_obj_add_flag(sb,LV_OBJ_FLAG_HIDDEN); lv_obj_remove_flag(sb,LV_OBJ_FLAG_SCROLLABLE); lv_obj_remove_flag(sb,LV_OBJ_FLAG_CLICKABLE);
+  sb_t=lv_label_create(sb); lv_obj_set_style_text_font(sb_t,&gu_sb150,0); lv_obj_set_style_text_letter_space(sb_t,-4,0); }
+bool gw_standby_is_on(void){ return sb&&!lv_obj_has_flag(sb,LV_OBJ_FLAG_HIDDEN); }
+static void sb_opa(void* o,int32_t v){ lv_obj_set_style_opa((lv_obj_t*)o,(lv_opa_t)v,0); }
+static void sb_fade(lv_obj_t* o,int from,int ms){ lv_anim_t a; lv_anim_init(&a); lv_anim_set_var(&a,o); lv_anim_set_exec_cb(&a,sb_opa);
+  lv_anim_set_values(&a,from,LV_OPA_COVER); lv_anim_set_duration(&a,ms); lv_anim_set_path_cb(&a,lv_anim_path_ease_out); lv_anim_start(&a); }
+// enter: time fades in over 280 ms (ease-out) on the black layer -- the only motion in standby
+void gw_standby_show(bool on){ if(!sb) return; if(on){ lv_obj_remove_flag(sb,LV_OBJ_FLAG_HIDDEN); lv_obj_move_foreground(sb); sb_fade(sb_t,0,280); } else lv_obj_add_flag(sb,LV_OBJ_FLAG_HIDDEN); }
+void gw_standby_set(int hh,int mm,uint32_t minute_count){
+  if(!sb) return; char b[8]; snprintf(b,sizeof b,"%02d:%02d",hh,mm);
+  if(strcmp(lv_label_get_text(sb_t),b)&&gw_standby_is_on()) sb_fade(sb_t,LV_OPA_40,200);   // minute change: quick soft re-light
+  lv_label_set_text(sb_t,b);
+  lv_obj_set_style_text_color(sb_t,col(0xF2F2F7),0);   // night: col() turns this into dim warm white
+  const signed char* o=sb_orbit[minute_count%8]; lv_obj_align(sb_t,LV_ALIGN_CENTER,o[0],o[1]-6); }
