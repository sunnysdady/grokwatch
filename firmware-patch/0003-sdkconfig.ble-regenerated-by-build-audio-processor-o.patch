From: GrokWatch <gw@local>
Date: Sat, 24 Oct 2026 23:04:55 +0800
Subject: [PATCH 3/5] sdkconfig.ble: regenerated by build (audio processor on,
 matches 2.6.2 bins)

---
 sdkconfig.ble | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/sdkconfig.ble b/sdkconfig.ble
index d293add..77ae2a0 100644
--- a/sdkconfig.ble
+++ b/sdkconfig.ble
@@ -1146,10 +1146,7 @@ CONFIG_WAKE_WORD_DISABLED=y
 # CONFIG_USE_AFE_WAKE_WORD is not set
 # CONFIG_USE_CUSTOM_WAKE_WORD is not set
 # default:
-# default:
-# CONFIG_WAKE_WORD_DETECTION_IN_LISTENING is not set
-# default:
-# CONFIG_USE_AUDIO_PROCESSOR is not set
+CONFIG_USE_AUDIO_PROCESSOR=y
 # default:
 # CONFIG_USE_SERVER_AEC is not set
 # default:
@@ -3615,6 +3612,8 @@ CONFIG_LOG_DEFAULT_LEVEL=2
 # default:
 CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
 # default:
+# CONFIG_LOG_MAXIMUM_LEVEL_INFO is not set
+# default:
 # CONFIG_LOG_MAXIMUM_LEVEL_DEBUG is not set
 # default:
 # CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE is not set
