{
    "manufacturer": "m5stack",
    "type": "m5stack-stopwatch",
    "target": "esp32s3",
    "builds": [
        {
            "name": "m5stack-stopwatch",
            "sdkconfig_append": [
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_OTA_URL=\"http://YOUR-OTA-SERVER:8003/xiaozhi/ota/\""
            ]
        }
    ]
}